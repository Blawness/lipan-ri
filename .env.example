DATABASE_URL=postgres://postgres:postgres@localhost:5432/lipanri

# Auth.js session secret (generate: openssl rand -base64 32)
AUTH_SECRET=
# Bootstrap admin (used by `pnpm admin:create`)
ADMIN_EMAIL=admin@lipan-ri.org
ADMIN_PASSWORD=
ADMIN_NAME=Admin LIPAN RI

# Cloudflare R2 (image upload + gallery)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lipan-ri
R2_PUBLIC_URL=
